# Jace Media. Copy to .env.local for local development and fill in.
# Never commit real values. In production, set these in Vercel → Settings → Environment Variables.

# From Jace (https://jaceo.vercel.app), signed in as the site owner so Jace Media is an official app
# (automatic sign-in): profile → Manage account → Developer → register "Jace Media" with redirect URIs
#   https://<your-vercel-domain>/api/auth/callback
#   http://localhost:3000/api/auth/callback
JACE_CLIENT_ID=
JACE_CLIENT_SECRET=

# 32+ random characters that encrypt the sign-in cookie. Changing it signs everyone out.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Postgres (Neon from Vercel → Storage sets this). Leave empty locally to use PGlite in ./data.
DATABASE_URL=

# Optional. Turns on YouTube trending, YouTube search, and topic-based recommendations.
# Google Cloud console → enable "YouTube Data API v3" → Credentials → API key.
# YOUTUBE_API_KEY=
# YOUTUBE_REGION=US
# Optional. Starter YouTube channels (comma-separated ids) used before someone has history.
# YOUTUBE_CHANNELS=

# Optional. Which Mastodon and Lemmy servers to read from.
# MASTODON_SERVER=mastodon.social
# LEMMY_SERVER=lemmy.world

# Optional. This app's public URL (for the OAuth redirect URI). Defaults to the request's URL.
# APP_URL=http://localhost:3000

# Optional. Defaults to https://jaceo.vercel.app. Use http://localhost:4000 with scripts/mock-jace.mjs.
# JACE_URL=http://localhost:4000
