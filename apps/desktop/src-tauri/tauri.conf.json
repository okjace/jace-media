{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jace Media",
  "version": "2.1.0",
  "identifier": "com.okjace.jacemedia",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "app"
    ],
    "category": "Video",
    "shortDescription": "Videos, Shorts, and posts from everywhere, with no ads.",
    "longDescription": "Jace Media: YouTube, Jace videos, and posts from Bluesky, Mastodon, Lemmy, and more in one place, with no ads.",
    "copyright": "okjace, MIT license",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}